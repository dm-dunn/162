# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/mlb162
DB_POOL_MAX=20

# Redis (optional — falls back to in-memory cache)
REDIS_URL=redis://localhost:6379

# JWT — IMPORTANT: Generate a strong secret with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=MLB162 <noreply@yourdomain.com>

# App URL (used in email links — set to production frontend URL in production)
APP_URL=http://localhost:5173
